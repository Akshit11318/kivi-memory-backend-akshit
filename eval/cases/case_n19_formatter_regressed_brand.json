    "formatted": "The Fiver invoice is ready.",
    "user_id": "demo_user"
  },
  "expected": {
    "decision": "APPLY",
    "memory_aware": "The Fiverr invoice is ready.",
    "reason": "Formatter regressed the brand's doubled-consonant spelling; the ASR surface recovered via alignment matches the stored form and the memory restores it.",
    "memory_row_count": 1,
    "expected_profile_results": {
      "off": {"decision": "ABSTAIN", "memory_aware": "The Fiver invoice is ready."},
      "exact": {
        "decision": "APPLY",
        "memory_aware": "The Fiverr invoice is ready.",
        "reasons": ["ok"],
        "affected_tokens": [{"from": "Fiver", "to": "Fiverr"}]
      },
      "phonetic": {
        "decision": "APPLY",
        "memory_aware": "The Fiverr invoice is ready.",
        "reasons": ["ok"],
        "affected_tokens": [{"from": "Fiver", "to": "Fiverr"}]
      },
      "llm": {
        "decision": "APPLY",
        "memory_aware": "The Fiverr invoice is ready."
      }
    }
  }
