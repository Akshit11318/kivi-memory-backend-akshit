  "title": "Deliberate respelling by dropped letter, taught as a standing dictionary entry",
  "why_real": "A public figure's respelling dropped a vowel on purpose (Ajay Devgn), and once the user has taught that spelling, every dictation that produces the ordinary-looking surface form must still come back as the respelled name.",
  "setup": {
    "observations": [
      {
        "source": "dictionary_add",
        "canonical": "Devgn",
        "forms": ["devgn", "devgan"]
      }
    ]
  },
  "inputs": {
    "asr": "devgan sir approved it",
    "formatted": "Devgan sir approved it.",
    "user_id": "demo_user"
  },
  "expected": {
    "decision": "APPLY",
    "memory_aware": "Devgn sir approved it.",
    "reason": "The dictionary entry's forms list already contains the surface 'devgan', so both exact and phonetic retrieve it and rewrite to the taught canonical.",
    "memory_row_count": 1,
    "expected_profile_results": {
      "off": {
        "decision": "ABSTAIN",
        "memory_aware": "Devgan sir approved it."
      },
      "exact": {
        "decision": "APPLY",
        "memory_aware": "Devgn sir approved it.",
        "reasons": ["ok"],
        "affected_tokens": [{"from": "Devgan", "to": "Devgn"}]
      },
      "phonetic": {
        "decision": "APPLY",
        "memory_aware": "Devgn sir approved it.",
        "reasons": ["ok"],
        "affected_tokens": [{"from": "Devgan", "to": "Devgn"}]
      },
      "llm": {
        "decision": "APPLY",
        "memory_aware": "Devgn sir approved it."
      }
    }
  }
}
